# ============================================================
# SpareFlow Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit the .env file with real secrets to version control.
# ============================================================

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# Server port (default: 5000)
PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# API version prefix
API_VERSION=v1

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# ============================================================
# AUTHENTICATION
# ============================================================

# JWT Secret Key (Use a strong random string)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_must_be_strong_and_random

# JWT Token Expiration (default: 7 days)
JWT_EXPIRY=7d

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================

# Frontend application URL
CLIENT_URL=http://localhost:3000

# ============================================================
# LOGGING
# ============================================================

# Log level (info, error, warn, debug)
LOG_LEVEL=info

# Enable logging (true/false)
ENABLE_LOGGING=true

# ============================================================
# SECURITY
# ============================================================

# Enable CORS (true/false)
ENABLE_CORS=true

# Enable rate limiting (true/false)
ENABLE_RATE_LIMIT=true

# Global API rate limit (development defaults to 300, production to 100)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000


# ============================================================
# EMAIL CONFIGURATION (Future Enhancement)
# ============================================================

# SMTP host for sending emails
SMTP_HOST=smtp.gmail.com

# SMTP port
SMTP_PORT=587

# Email account for sending
SMTP_USER=your_email@gmail.com

# Email account password or app-specific password
SMTP_PASS=your_app_specific_password

# Sender email address
SENDER_EMAIL=noreply@spareflow.com

# ============================================================
# CLOUD STORAGE (Future Enhancement)
# ============================================================

# AWS S3 Configuration
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================
# PAYMENT GATEWAY (Future Enhancement)
# ============================================================

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# DEBUGGING AND DEVELOPMENT
# ============================================================

# Debug mode
DEBUG=false

# Verbose logging
VERBOSE=false